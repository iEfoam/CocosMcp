{
  "name": "cocos-mcp-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.22.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "build": "node scripts/project-env.mjs node scripts/build.mjs",
    "typecheck": "node scripts/project-env.mjs tsc --noEmit",
    "test": "node scripts/project-env.mjs node scripts/test.mjs",
    "start": "node scripts/project-env.mjs node .codex-work/build/server/cli.mjs",
    "catalog": "node scripts/project-env.mjs node .codex-work/build/server/cli.mjs catalog",
    "check": "pnpm typecheck && pnpm build && pnpm test && pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "ajv": "8.20.0",
    "hono": "4.11.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "esbuild": "0.28.2"
  }
}
