// 噪声使用屏幕坐标，纹理采样保留 Sprite 的图集 UV；移动对象会改变噪声图案。
CCEffect %{
  techniques:
  - passes:
    - vert: dissolve-vs:vert
      frag: dissolve-fs:frag
      depthStencilState:
        depthTest: false
        depthWrite: false
      rasterizerState:
        cullMode: none
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      properties:
        threshold: { value: 0.3, editor: { range: [0, 1] } }
}%
CCProgram dissolve-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;
  out vec2 uv;
  out vec4 vertexColor;
  vec4 vert () {
    vec4 position = vec4(a_position, 1.0);
    #if USE_LOCAL
      position = cc_matWorld * position;
    #endif
    uv = a_texCoord;
    vertexColor = a_color;
    return cc_matViewProj * position;
  }
}%
CCProgram dissolve-fs %{
  precision highp float;
  #include <builtin/internal/embedded-alpha>
  in vec2 uv;
  in vec4 vertexColor;
  uniform Dissolve { float threshold; };
  #pragma builtin(local)
  layout(set = 2, binding = 12) uniform sampler2D cc_spriteTexture;
  vec4 frag () {
    vec2 cell = floor(gl_FragCoord.xy / 6.0);
    float noise = fract(sin(dot(cell, vec2(12.9898, 78.233))) * 43758.5453);
    if (noise < threshold) discard;
    return CCSampleWithAlphaSeparated(cc_spriteTexture, uv) * vertexColor;
  }
}%
