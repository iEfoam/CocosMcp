{
  "name": "cocos-mcp-creator3",
  "title": "CocosMCP · Creator 3",
  "version": "0.1.0",
  "package_version": 2,
  "editor": ">=3.0.0 <4.0.0",
  "description": "免费开源的 AI 编辑器桥接：连接 MCP 客户端与 Creator 场景、资源和开发运行时。",
  "author": "iefoam@foxmail.com",
  "homepage": "https://github.com/iEfoam/CocosMcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/iEfoam/CocosMcp.git"
  },
  "bugs": {
    "url": "https://github.com/iEfoam/CocosMcp/issues"
  },
  "license": "MIT",
  "main": "./dist/main.cjs",
  "contributions": {
    "menu": [
      {
        "path": "CocosMCP",
        "label": "关于 CocosMCP",
        "message": "about"
      },
      {
        "path": "CocosMCP",
        "label": "打开控制中心",
        "message": "open"
      },
      {
        "path": "CocosMCP",
        "label": "检查更新",
        "message": "check-updates"
      }
    ],
    "messages": {
      "start": {
        "methods": [
          "start"
        ]
      },
      "stop": {
        "methods": [
          "stop"
        ]
      },
      "status": {
        "methods": [
          "status"
        ]
      },
      "open": {
        "methods": [
          "open"
        ]
      },
      "panel-state": {
        "methods": [
          "panelState"
        ]
      },
      "service-start": {
        "methods": [
          "startService"
        ]
      },
      "service-stop": {
        "methods": [
          "stopService"
        ]
      },
      "extension-update": {
        "methods": [
          "updateExtension"
        ]
      },
      "set-language": {
        "methods": [
          "setLanguage"
        ]
      },
      "copy-log": {
        "methods": [
          "copyLog"
        ]
      },
      "about": {
        "methods": [
          "about"
        ]
      },
      "check-updates": {
        "methods": [
          "checkUpdates"
        ]
      },
      "extension-check": {
        "methods": [
          "checkExtension"
        ]
      }
    },
    "scene": {
      "script": "./dist/scene.cjs",
      "methods": [
        "dispatch"
      ]
    }
  },
  "panels": {
    "default": {
      "main": "dist/panel.cjs",
      "type": "dockable",
      "title": "CocosMCP 控制中心",
      "size": {
        "width": 720,
        "height": 620,
        "min-width": 520,
        "min-height": 440
      }
    }
  }
}
